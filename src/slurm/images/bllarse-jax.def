Bootstrap: docker
From: python:3.12

%post
    # python:3.12, not nvidia/cuda:*-ubuntu24.04: MPCDF does not list users in
    # /etc/subuid, so `apptainer build` on the cluster falls back to a
    # root-mapped namespace with no working fakeroot. Under that namespace
    # apt-get cannot drop privileges to the _apt user and dies with
    #     E: setgroups 65534 failed - setgroups (1: Operation not permitted)
    #     E: Method http has died unexpectedly!
    # so ANY apt-get-based %post is unbuildable there. The docker `python`
    # images already ship python3.12, pip, a bare `python` on PATH, and git --
    # exactly what the deleted apt-get line was installing -- so dropping the
    # distro base removes the one build step that cannot run.
    #
    # Losing the CUDA base costs nothing, by the same argument that justified
    # picking nvidia/cuda in the first place: jax[cuda12] ships its own CUDA
    # and cuDNN redistributables as pip wheels, and `apptainer --nv` binds the
    # host driver, so the base image's CUDA version was never load-bearing.
    #
    # --break-system-packages is gone too: it was only needed because Ubuntu
    # marks its distro python PEP 668 externally-managed. These images do not.
    pip install --no-cache-dir \
        "jax[cuda12]" equinox optax "tfp-nightly[jax]" \
        datasets equimo augmax mlflow python-dotenv tqdm "optuna>=4.0" \
        "blrax @ git+https://github.com/dimarkov/blrax.git@main"

%environment
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export XLA_PYTHON_CLIENT_ALLOCATOR=platform
